<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f0f8ff;
    padding: 30px;
    line-height: 1.6;
}

h1 {
    text-align: center;
    color: #2c3e50;
    margin-bottom: 40px;
    font-size: 2.2rem;
}

section {
    background: white;
    padding: 25px;
    margin-bottom: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

h2 {
    color: #3498db;
    margin-bottom: 20px;
    border-bottom: 2px solid #e8f4fc;
    padding-bottom: 8px;
}



.photo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.photo-card {
    border-radius: 8px;
    overflow: hidden;
    background: #f8f9fa;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.photo-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
}

.photo-card img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
}

.photo-name {
    padding: 8px;
    font-size: 0.9rem;
    color: #2c3e50;
    font-weight: 500;
}


.music-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 14px;
    margin-bottom: 12px;
    background: #fef9e7;
    border-radius: 8px;
    transition: background 0.3s ease, transform 0.3s ease;
}

.music-item:hover {
    background: #fff3c4;
    transform: translateX(5px);
}

.music-item b {
    color: #3498db;
}

.music-item audio {
    width: 100%;
    height: 40px;
}


.dest-video-card {
    margin-bottom: 20px;
    border-radius: 10px;
    overflow: hidden;
    background: #eef9f4;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
}

.dest-name-bar {
    padding: 12px;
    font-weight: bold;
    color: #27ae60;
    font-size: 1.05rem;
}

.video-wrapper {
    width: 100%;
}

.video-wrapper video {
    width: 100%;
    height: auto;
    display: block;
}



/* Tablets */
@media (max-width: 900px) {
    body {
        padding: 20px;
    }

    .photo-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    h1 {
        font-size: 2rem;
    }
}


/* Mobile Phones */
@media (max-width: 600px) {
    body {
        padding: 15px;
    }

    section {
        padding: 18px;
    }

    h1 {
        font-size: 1.7rem;
        margin-bottom: 25px;
    }

    h2 {
        font-size: 1.3rem;
    }

    .photo-grid {
        grid-template-columns: 1fr;
    }

    .photo-card img {
        height: 200px;
    }

    .music-item {
        padding: 12px;
    }

    .dest-name-bar {
        font-size: 1rem;
    }
}
</style>
    <h1>🫰🏻 My Multimedia Page 🫰🏻</h1>
